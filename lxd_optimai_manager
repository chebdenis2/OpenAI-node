        elif [ "$DOCKER_DRIVER" = "fuse-overlayfs" ] || [ "$DOCKER_DRIVER" = "vfs" ]; then
            echo "→ Обнаружен storage-driver: $DOCKER_DRIVER, пробуем миграцию на overlay2"
        fi

