    echo "=== Проверка сети LXD перед установкой Docker ==="
    ensure_host_lxd_docker_modules
    ensure_host_ipv4_forwarding
    ensure_lxdbr0_network_health || {
        echo "❌ Сеть lxdbr0 не готова. Сначала повтори пункт 2."
        read -p "Нажми Enter..." && return
    }
    ensure_manual_lxd_nat_rules || true

    load_proxy_settings
    proxy_prompted=0
    if [ -n "$GLOBAL_PROXY_URL" ]; then
        echo "✓ Используется сохранённый HTTP(S)-прокси"
    fi

    configured_count=0
    failed_count=0

    for container in $CONTAINERS; do
        echo ""
        echo "--- $container ---"

        desired_kernel_modules="overlay,br_netfilter,ip_tables,iptable_nat,xt_conntrack"
        desired_raw_lxc="lxc.apparmor.profile=unconfined
lxc.mount.auto=proc:rw sys:rw cgroup:rw
lxc.cgroup.devices.allow=a
lxc.cap.drop="
        needs_restart=0

        for cfg in \
            "security.privileged=true" \
            "security.nesting=true" \
            "security.syscalls.intercept.mknod=true" \
            "security.syscalls.intercept.setxattr=true" \
            "security.syscalls.intercept.sysctl=true"; do
            key="${cfg%%=*}"
            val="${cfg#*=}"
            current="$(lxc config get "$container" "$key" 2>/dev/null || true)"
            if [ "$current" != "$val" ]; then
                lxc config set "$container" "$key" "$val" >/dev/null 2>&1 || true
                needs_restart=1
            fi
        done

        current_kernel_modules="$(lxc config get "$container" linux.kernel_modules 2>/dev/null || true)"
        if [ "$current_kernel_modules" != "$desired_kernel_modules" ]; then
            lxc config set "$container" linux.kernel_modules "$desired_kernel_modules" >/dev/null 2>&1 || true
            needs_restart=1
        fi

        current_raw_lxc="$(lxc config get "$container" raw.lxc 2>/dev/null || true)"
        if [ "$current_raw_lxc" != "$desired_raw_lxc" ]; then
            lxc config set "$container" raw.lxc "$desired_raw_lxc" >/dev/null 2>&1 || true
            needs_restart=1
        fi

        proc_limit="$(lxc config get "$container" limits.processes 2>/dev/null || true)"
        if ! [[ "$proc_limit" =~ ^[0-9]+$ ]] || [ "$proc_limit" -lt 8192 ]; then
            lxc config set "$container" limits.processes 8192 >/dev/null 2>&1 || true
            needs_restart=1
        fi

        if [ "$needs_restart" -eq 1 ]; then
            echo "→ Применены LXD-параметры для Docker, перезапускаем $container..."
            lxc restart "$container" >/dev/null 2>&1 || true
            sleep 8
