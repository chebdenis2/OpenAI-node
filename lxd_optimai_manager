start_nodes() {
    local max=$(get_max_container)
    echo "Какие ноды запустить? (например: 5, 1-10 или Enter для всех 1-$max)"
    read -r range
    result=$(parse_range "$range")
    if [ $? -ne 0 ]; then
        echo "✗ $result"
        read -p "Нажми Enter для продолжения..."
        return
    fi

    start=$(echo $result | cut -d' ' -f1)
    end=$(echo $result | cut -d' ' -f2)
    total_nodes=$((end - start + 1))
    inter_node_delay=2
    if [ "$total_nodes" -gt 10 ]; then
        inter_node_delay=8
    fi

    if [ "$start" -eq "$end" ]; then
        echo "Запуск ${CONTAINER_PREFIX}${start}..."
    else
        echo "Запуск нод с ${CONTAINER_PREFIX}${start} по ${CONTAINER_PREFIX}${end}..."
    fi
    echo "Интервал запуска между нодами: ${inter_node_delay}с"

    for i in $(seq $start $end); do
        node_name="${CONTAINER_PREFIX}${i}"
        echo "[$i] Запуск ${node_name}..."
        lxc list -c n --format csv | grep -q "^${node_name}$" || { echo "нет"; continue; }

        needs_restart=0
        desired_kernel_modules="overlay,br_netfilter,ip_tables,iptable_nat,xt_conntrack"
        desired_raw_lxc="lxc.apparmor.profile=unconfined
lxc.mount.auto=proc:rw sys:rw cgroup:rw
lxc.cgroup.devices.allow=a
lxc.cap.drop="
        for cfg in \
            "security.privileged=true" \
            "security.nesting=true" \
            "security.syscalls.intercept.mknod=true" \
            "security.syscalls.intercept.setxattr=true" \
            "security.syscalls.intercept.sysctl=true"; do
            key="${cfg%%=*}"
            val="${cfg#*=}"
            current="$(lxc config get "$node_name" "$key" 2>/dev/null || true)"
            if [ "$current" != "$val" ]; then
                lxc config set "$node_name" "$key" "$val" >/dev/null 2>&1 || true
                needs_restart=1
            fi
        done

        current_kernel_modules="$(lxc config get "$node_name" linux.kernel_modules 2>/dev/null || true)"
        if [ "$current_kernel_modules" != "$desired_kernel_modules" ]; then
            lxc config set "$node_name" linux.kernel_modules "$desired_kernel_modules" >/dev/null 2>&1 || true
            needs_restart=1
        fi

        current_raw_lxc="$(lxc config get "$node_name" raw.lxc 2>/dev/null || true)"
        if [ "$current_raw_lxc" != "$desired_raw_lxc" ]; then
            lxc config set "$node_name" raw.lxc "$desired_raw_lxc" >/dev/null 2>&1 || true
            needs_restart=1
        fi

        proc_limit="$(lxc config get "$node_name" limits.processes 2>/dev/null || true)"
        if ! [[ "$proc_limit" =~ ^[0-9]+$ ]] || [ "$proc_limit" -lt 8192 ]; then
            lxc config set "$node_name" limits.processes 8192 >/dev/null 2>&1 || true
            needs_restart=1
        fi

        if [ "$needs_restart" -eq 1 ]; then
            echo "[DEBUG] Применены docker-совместимые параметры LXD, перезапуск ${node_name}..."
            lxc restart "$node_name" >/dev/null 2>&1 || true
            sleep 8
        fi

        if lxc exec "$node_name" -- bash << 'SCRIPT'
set -e
mkdir -p /var/log/optimai

echo "[DEBUG] Проверка optimai-cli..."
if [ ! -x /usr/local/bin/optimai-cli ]; then
    echo "✗ ОШИБКА: /usr/local/bin/optimai-cli не найден!"
    exit 1
fi

echo "[DEBUG] Проверка Docker..."
if ! systemctl is-active docker >/dev/null 2>&1; then
