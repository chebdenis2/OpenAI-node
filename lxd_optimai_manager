    systemctl restart docker || true
    sleep 5
    timeout 20 docker ps -a >/dev/null 2>&1 || true
fi

sysctl -w vm.overcommit_memory=1 >/dev/null 2>&1 || true

echo "[DEBUG] Удаляем старый crawler контейнер (если есть)..."
timeout 20 docker rm -f optimai_crawl4ai_0_7_3 >/dev/null 2>&1 || true

echo "[DEBUG] Настройка systemd сервиса optimai-node..."
cat > /etc/systemd/system/optimai-node.service <<'UNIT'
