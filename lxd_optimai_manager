systemctl daemon-reload
systemctl enable optimai-node >/dev/null 2>&1 || true
systemctl reset-failed optimai-node >/dev/null 2>&1 || true
systemctl restart optimai-node
sleep 5

if systemctl is-active optimai-node >/dev/null 2>&1; then
    echo "✓ optimai-node service запущен"
else
    echo "✗ optimai-node не запустился. Последние логи:"
    journalctl -u optimai-node -n 40 --no-pager || true
    echo "----- /var/log/optimai/node.log -----"
    tail -n 80 /var/log/optimai/node.log 2>/dev/null || echo "node.log пуст или отсутствует"
